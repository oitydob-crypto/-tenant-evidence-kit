{
  "name": "tenant-evidence-kit",
  "version": "0.1.1",
  "description": "A TypeScript toolkit for private, multi-tenant evidence workflows with Supabase.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oitydob-crypto/tenant-evidence-kit.git"
  },
  "homepage": "https://github.com/oitydob-crypto/tenant-evidence-kit#readme",
  "bugs": {
    "url": "https://github.com/oitydob-crypto/tenant-evidence-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "supabase"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "supabase",
    "typescript",
    "multi-tenant",
    "rls",
    "storage",
    "evidence",
    "signed-url",
    "privacy"
  ]
}
